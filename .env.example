# Server Port
PORT=3000

# SMTP Postfix Configuration
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
MAIL_FROM=campaigns@airepro.in

# Connection Pooling Settings for High Volume (10k+ Emails)
SMTP_MAX_CONNECTIONS=15
SMTP_MAX_MESSAGES=200
# Rate limit in emails/sec (0 for maximum speed, e.g. 50 for rate limiting)
SMTP_RATE_LIMIT=0
